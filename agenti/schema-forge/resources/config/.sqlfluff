# Configurazione sqlfluff di Schema Forge.
#
# Il gate NON viene declassato: sqlfluff resta bloccante. Qui si dichiara solo
# quali regole di default sono in conflitto con convenzioni SCRITTE della skill,
# e perche'. Ogni disattivazione ha la sua motivazione sulla riga sopra: una
# regola spenta senza motivo scritto e' una regola che nessuno rimettera' mai.
#
# Uso:  sqlfluff lint --dialect postgres --config <questo file> supabase/migrations
# Il comando `forge` la copia nella radice del progetto generato, cosi' il gate
# e' riproducibile anche fuori dalla skill.

[sqlfluff]
dialect = postgres

# PG01 "CREATE INDEX should use CONCURRENTLY to avoid locking the table".
# `create index concurrently` non puo' stare dentro una transazione, e il CLI
# Supabase applica ogni migrazione dentro una transazione: la regola chiede una
# cosa impossibile in questo contesto. Su una tabella appena creata, per giunta,
# non c'e' traffico da non bloccare. Su una tabella grande e gia' in produzione
# l'indice si crea fuori migrazione, a mano — vedi references/migrazioni.md,
# tabella delle operazioni pericolose.
exclude_rules = PG01

# RF04 "Keywords should not be used as identifiers".
# `name` e `label` sono parole chiave NON RISERVATE in Postgres: legali come
# identificatori senza virgolette, e sono i nomi imposti da
# references/pattern-ecommerce.md. Si esentano queste due parole, non si spegne
# la regola: su una parola davvero riservata continua a scattare.
[sqlfluff:rules:references.keywords]
ignore_words = name,label
