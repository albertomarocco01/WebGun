// Configurazione knip degli script di Speed Demon.
// Ogni esenzione ha la motivazione sulla riga sopra: un'esenzione senza motivo
// scritto e' un'esenzione che nessuno rimettera' mai (DECISIONI.md §8).
{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // `verify.mjs` e' un ENTRY POINT da riga di comando, non un modulo importato;
  // le batterie si lanciano con `node --test`. Senza queste righe knip li
  // dichiara file morti.
  "entry": ["scripts/verify.mjs", "scripts/*.test.mjs"],
  "project": ["scripts/**/*.mjs"],

  // eslint e jscpd non si importano: li ESEGUE `code-maniac scan` come binari.
  // Toglierli dal package.json spegnerebbe due passi della batteria.
  // `lighthouse` arriva il 2026-08-06 (referto § H12): il gate lo lancia per
  // PERCORSO (`node <skill>/node_modules/lighthouse/cli/index.js`), non con un
  // import — ed e' esattamente il punto, perche' prima lo scaricava `npx --yes`
  // a ogni giro, non fissato, dalla radice del progetto misurato.
  "ignoreDependencies": ["eslint", "jscpd", "lighthouse"]
}
