// Configurazione knip degli script di Gestionale Crafter.
// Ogni esenzione ha la motivazione sulla riga sopra: un'esenzione senza motivo
// scritto e' un'esenzione che nessuno rimettera' mai (DECISIONI.md §8).
{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // I due script sono ENTRY POINT da riga di comando, non moduli importati:
  // `verify.mjs` invoca `admin-audit.mjs` come processo separato, e l'audit si
  // lancia anche a mano. La configurazione dell'accessibilita' la carica ESLint
  // per PERCORSO (`--config`), non con un import: senza queste righe knip la
  // dichiara file morto e i suoi due pacchetti dipendenze inutilizzate. Stessa
  // forma di flow-sentinel, che aveva gia' lo stesso caso.
  "entry": [
    "scripts/verify.mjs",
    "scripts/admin-audit.mjs",
    "scripts/*.test.mjs",
    "resources/config/eslint-a11y.config.mjs"
  ],
  "project": ["scripts/**/*.mjs", "resources/config/**/*.mjs"],

  // jscpd non si importa: lo ESEGUE `code-maniac scan` come binario.
  // `eslint` e' uscito da questo elenco il 2026-08-06: ora la skill lo usa
  // davvero — carica la propria configurazione dell'accessibilita' — e knip lo
  // riconosce da solo. Stessa forma di flow-sentinel.
  "ignoreDependencies": ["jscpd"]
}
