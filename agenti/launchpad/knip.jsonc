// Configurazione knip degli script di Launchpad.
// Ogni esenzione ha la motivazione sulla riga sopra: un'esenzione senza motivo
// scritto e' un'esenzione che nessuno rimettera' mai (DECISIONI.md §8).
{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  // I tre gusci sono ENTRY POINT da riga di comando, non moduli importati; le
  // batterie si lanciano con `node --test`. Senza queste righe knip li dichiara
  // file morti.
  "entry": ["scripts/verify.mjs", "scripts/segreti.mjs", "scripts/impronta.mjs", "scripts/*.test.mjs"],
  "project": ["scripts/**/*.mjs"],

  // eslint e jscpd non si importano: li ESEGUE `code-maniac scan` come binari.
  // Toglierli dal package.json spegnerebbe due passi della batteria.
  "ignoreDependencies": ["eslint", "jscpd"]
}
